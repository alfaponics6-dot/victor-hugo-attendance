# Dependencies
node_modules/

# Database (incl. SQLite WAL/SHM siblings, which carry uncheckpointed data)
*.db
*.db-wal
*.db-shm
*.db-journal

# Backups
server/backups/

# Uploads
server/uploads/

# Build
client/dist/

# Environment
.env
.env.local
.env.production

# VAPID keys (Web Push) — generated on first server boot
server/vapid-keys.json

# Microsoft Graph refresh token (rotates after each token exchange)
server/ms-graph-token.json

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Temp
*.tmp
.temp/

# LaTeX build artifacts
*.aux
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# Office lock files
~$*

# Stray Windows reserved-name capture (occurs when a Unix-style "> nul" runs in PowerShell)
docs/nul
