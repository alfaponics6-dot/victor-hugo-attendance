# Server Configuration
PORT=3000
NODE_ENV=production

# CORS Configuration - comma-separated list of allowed origins.
# Required in production; the allowlist is always honored regardless of TRUST_PROXY.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Configuration
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-cryptographically-random-base64-secret
# Default is "30d" — long enough that an offline shift (the field-use
# case) doesn't expire the cookie mid-session. Override for stricter
# session lifetimes.
JWT_EXPIRES_IN=30d

# Leader access code - required for leader-role logins.
# Generate with: node -e "console.log(require('crypto').randomBytes(12).toString('base64').replace(/[+\/=]/g, '').toUpperCase().slice(0, 14))"
LEADER_ACCESS_CODE=change-me

# Database (optional - defaults to ./attendance.db)
# DB_PATH=/var/lib/victorhugo/attendance.db

# Set to true when behind ngrok / Cloudflare Tunnel; affects req.ip parsing only.
TRUST_PROXY=false

# --- Web Push wake-up (optional) ---
# Generated automatically on first boot to server/vapid-keys.json. Set
# explicitly here only if you want to manage VAPID keys outside the
# filesystem (e.g., a secrets manager).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:cchery@earth.ac.cr

# Cron schedule for the push wake-up job. Default = every 30 min from
# 06:00 to 22:00 America/Costa_Rica. Use "* * * * *" for 1-min testing.
# PUSH_CRON_SCHEDULE=*/30 6-22 * * *
# PUSH_CRON_TZ=America/Costa_Rica
# PUSH_CRON_DISABLE=true   # skip the cron entirely (CI / one-off scripts)

# --- Email escalation via Microsoft Graph (optional) ---
# Fires from the same cron tick: when a leader has had data pending for
# more than SYNC_EMAIL_STALE_MINUTES (default 60) and no email was sent
# in the last 24 hours, sends a nudge to leaders.email.
# Skipped automatically if MS_GRAPH_CLIENT_ID + MS_GRAPH_REFRESH_TOKEN
# aren't set — the server boots fine without email.
#
# Setup (one-time, ~5 minutes):
#   1. portal.azure.com → App registrations → New registration
#      Name: "Asistencia EF 2026 Mailer"
#      Supported account types: "Personal Microsoft accounts only"
#      Redirect URI: leave empty (device-code flow doesn't need one)
#   2. After creation, copy "Application (client) ID" → MS_GRAPH_CLIENT_ID below
#   3. API permissions → Add → Microsoft Graph → Delegated:
#      Mail.Send + offline_access → Add permissions
#   4. Authentication → "Allow public client flows" = Yes → Save
#   5. On the server, run:
#        MS_GRAPH_CLIENT_ID=<id> node scripts/setup-ms-graph.js
#      Follow the device-code prompt; paste the printed refresh token
#      into MS_GRAPH_REFRESH_TOKEN below.
#   6. Restart the API.
#
# Refresh tokens rotate on each use. The mailer persists the rotated
# value to server/ms-graph-token.json (gitignored) so it survives
# restarts; the .env value is just the initial bootstrap.
MS_GRAPH_TENANT=consumers
MS_GRAPH_CLIENT_ID=
MS_GRAPH_REFRESH_TOKEN=
# MS_GRAPH_CLIENT_SECRET=      # only for confidential clients
# SYNC_EMAIL_STALE_MINUTES=60
# APP_URL=https://forestryescenary.com
