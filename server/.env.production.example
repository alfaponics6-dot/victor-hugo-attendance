# Production .env template for Oracle Cloud deployment.
#
# Steps:
#   1. Copy this file to /opt/victorhugo/server/.env on the VM.
#   2. Replace every <placeholder>.
#   3. chmod 600 /opt/victorhugo/server/.env  (only readable by the service user).
#   4. sudo systemctl restart victorhugo-api
#
# Never commit the populated .env — it is in .gitignore.

PORT=3000
NODE_ENV=production

# Public origin(s) for the SPA. Comma-separate if you have more than one.
# Example: https://attendance.earth.ac.cr
CORS_ORIGINS=https://<your-domain>

# Cryptographically random 48-byte secret. Generate fresh on the VM with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# DO NOT commit a real value to this file — it lives in the public-ish
# template; the actual secret only lives in the on-host .env (chmod 600).
JWT_SECRET=<paste-the-generated-base64-secret-here>
JWT_EXPIRES_IN=8h

# Leader access code (shared password for the leader-role cohort). Pick a
# memorable but non-trivial value; share it with leaders over a trusted
# channel. The dev/local value is intentionally not committed here.
LEADER_ACCESS_CODE=<choose-and-share-with-leaders>

# Database path on the host. The service user must own the parent directory
# (sqlite WAL/SHM siblings are created here too).
DB_PATH=/opt/victorhugo/server/attendance.db

# Rate-limit overrides (defaults: 200/min general, 30/min credential).
# LOGIN_RATE_LIMIT=30

# Behind nginx → trust the X-Forwarded-For header so express-rate-limit and
# the request logger see real client IPs. Always true on the Oracle Cloud
# deployment.
TRUST_PROXY=true
