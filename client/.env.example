# API Configuration
# In production the API and the SPA are served from the same origin, so leave
# this unset (the client defaults to /api). In local dev, the Vite proxy in
# vite.config.js handles routing /api to the Node server.
# VITE_API_BASE_URL=https://yourdomain.com/api

# "Always cc" address for the Correos tab's mailto links. Falls back to
# forestryscenary@earth.ac.cr if unset.
# VITE_COORDINATION_CC=forestryscenary@earth.ac.cr
